<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iPhone 16 Launcher</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  color:white;
  min-height:100vh;
  background:linear-gradient(145deg,#65b8ff,#b69cff,#f3a7d0);
  padding:20px;
}
.phone{
  max-width:420px;
  min-height:90vh;
  margin:auto;
  padding:20px;
  border:5px solid #222;
  border-radius:38px;
  background:#17234b40;
}
.island{
  width:110px;height:28px;
  background:#111;border-radius:20px;
  margin:0 auto 25px;
}
.time{text-align:center;font-size:52px;font-weight:300}
.date{text-align:center;margin-bottom:25px}
input{
  width:100%;padding:14px;
  border:0;border-radius:20px;
  margin-bottom:25px;font-size:16px;
}
.apps{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:25px 10px;
}
.app{
  border:0;background:none;color:white;
  text-align:center;font-size:12px;
  cursor:pointer;
}
.icon{
  width:58px;height:58px;
  border-radius:17px;
  display:grid;place-items:center;
  font-size:30px;margin:0 auto 8px;
  background:linear-gradient(145deg,#fff8,#ffffff30);
}
.dock{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:8px;padding:12px;margin-top:35px;
  border-radius:24px;background:#ffffff40;
}
.dock .icon{width:50px;height:50px}
</style>
</head>

<body>
<div class="phone">
  <div class="island"></div>
  <div class="date" id="date"></div>
  <div class="time" id="time"></div>

  <input id="search" placeholder="🔍 Search apps..."
